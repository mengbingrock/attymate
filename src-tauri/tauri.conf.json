{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AttyMate",
  "version": "0.1.0",
  "identifier": "com.attymate.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @paperclipai/ui dev",
    "beforeBuildCommand": "VITE_PAPERCLIP_API_URL=https://paperclip.attymate.com pnpm --filter @paperclipai/ui build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AttyMate",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "AttyMate desktop client",
    "longDescription": "AttyMate — Paperclip-based agent orchestration platform, packaged as a desktop client that talks to the central server at paperclip.attymate.com."
  }
}
