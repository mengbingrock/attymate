{
  "name": "@paperclipai/runner-client",
  "version": "0.3.1",
  "description": "Paperclip local execution runner — runs agent work on the user's machine",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "paperclip-runner": "./dist/index.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@paperclipai/adapter-utils": "workspace:*",
    "@paperclipai/adapter-claude-local": "workspace:*",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
